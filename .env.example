# ITS - IT Support Ticketing System - Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# MySQL / MariaDB connection (phpMyAdmin database)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=itsupport
MYSQL_USER=root
# Add the MySQL account password configured on this machine.
MYSQL_PASSWORD=

# JWT Secret (use a long random string in production)
JWT_SECRET=change-this-to-a-very-long-random-secret-key-in-production

# Application URL (used for email links)
APP_URL=http://localhost:3000

# SMTP Email Configuration (leave blank to use console fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=ITS Support <your-email@gmail.com>

# First Admin Account (seeded on first run if no users exist)
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=Admin1234
ADMIN_NAME=System Administrator

# Session/Token
TOKEN_EXPIRY=7d
RESET_TOKEN_EXPIRY_HOURS=2
